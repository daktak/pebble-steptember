[
  {
    "type": "heading",
    "defaultValue": "Steptember"
  },
  {
    "type": "text",
    "defaultValue": "Logs your daily steps to steptember.org.au. Steps are counted from midnight to sync time (default 11pm)."
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Account"
      },
      {
        "type": "input",
        "messageKey": "EMAIL",
        "label": "Email (Steptember)",
        "defaultValue": "",
        "attributes": {
          "placeholder": "you@example.com",
          "type": "email"
        }
      },
      {
        "type": "input",
        "messageKey": "PASSWORD",
        "label": "Password",
        "defaultValue": "",
        "attributes": {
          "placeholder": "••••••••",
          "type": "password"
        }
      }
    ]
  },
  {
    "type": "section",
